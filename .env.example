# Copy to .env and adjust. app/core/config.py::Settings reads these
# (pydantic-settings, env_file=".env"). See docs/RUNBOOK.md for the full
# setup walkthrough, including SQLite vs Postgres.

# Postgres (production/shared dev):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mars

# SQLite (local/demo, no Postgres install needed) -- uncomment instead:
# DATABASE_URL=sqlite:////tmp/fines_demo.db

API_TITLE=Mars Petcare -- Projected Fines API
API_VERSION=0.1.0

# Azure OpenAI, for the LLM-powered projection-explanation feature
# (POST /orders/{order_id}/explanation, app/agents/). Leave unset/blank to
# run without it -- app/core/config.py::Settings defaults every one of
# these to "", and app/agents/providers/azure_openai.py fails with a clear
# AzureOpenAIConfigError only when the explanation endpoint is actually
# called, not at app startup. Field names below must match
# Settings.azure_openai_* exactly (pydantic-settings matches env var
# names case-insensitively, e.g. AZURE_OPENAI_DEPLOYMENT_NAME, not
# AZURE_OPENAI_DEPLOYMENT).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# Per-call timeout and our own retry-wrapper's attempt budget (see
# app/agents/providers/azure_openai.py) -- real-world latency varies a
# lot by deployment/model/region, so this is tunable rather than
# hardcoded. Default is 1 attempt (no retry): measured directly against
# a real deployment, latency ranged ~2s-24s with no fixable pattern, so
# retrying just multiplies the wait rather than improving odds. Only
# raise AZURE_OPENAI_MAX_ATTEMPTS if you have evidence a retry actually
# recovers failures on your deployment (a genuinely transient blip).
AZURE_OPENAI_TIMEOUT_SECONDS=90
AZURE_OPENAI_MAX_ATTEMPTS=1
