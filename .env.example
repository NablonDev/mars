# Gmail IMAP
EMAIL_USERNAME=your_gmail_address@example.com
EMAIL_PASSWORD=your_gmail_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmir_db
DB_USER=cmir_user
DB_PASSWORD=change_me

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Azure Functions / Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_QUEUE_NAME=mail-processing
SERVICE_BUS_SESSION_ID=mail-processing
SERVICE_BUS_MAX_WAIT_SECONDS=30
SERVICE_BUS_LOCK_RENEW_SECONDS=300
QUEUE_ENQUEUE_BATCH_LIMIT=25

LOG_LEVEL=INFO
