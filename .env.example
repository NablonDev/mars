ENVIRONMENT=development
DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# docker-compose.yml uses mars:mars@db:5432/mars for app services.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Keep DB capacity >= worker concurrency to avoid DB-session contention.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# CMIR: inbound email (Gmail IMAP)
EMAIL_USERNAME=your_gmail_address@example.com
EMAIL_PASSWORD=your_gmail_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# CMIR: Azure Service Bus (mail-processing queue)
SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=mail-processing
SERVICE_BUS_SESSION_ID=mail-processing
SERVICE_BUS_MAX_WAIT_SECONDS=30
SERVICE_BUS_LOCK_RENEW_SECONDS=300
QUEUE_ENQUEUE_BATCH_LIMIT=25

# Azure OpenAI -- used by both CMIR extraction and the fines fine-summary feature
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_TIMEOUT_SECONDS=90
AZURE_OPENAI_MAX_ATTEMPTS=3

# Fines: batch job queue. Backend is "postgres" (poll job_item) or
# "service_bus" (message dispatch); job_item remains the source of truth for
# work state under both. Prefixed JOB_QUEUE_SERVICE_BUS_* to disambiguate
# from CMIR's own Service Bus queue above -- two independent queues.
JOB_QUEUE_BACKEND=postgres
# Auth is via managed identity -- namespace only, never a connection string.
JOB_QUEUE_SERVICE_BUS_NAMESPACE=
JOB_QUEUE_SERVICE_BUS_QUEUE_NAME=fine-projection-jobs
JOB_QUEUE_SERVICE_BUS_MAX_WAIT_SECONDS=10

# Batch worker. Raise DB_POOL_SIZE/DB_MAX_OVERFLOW alongside concurrency.
JOB_QUEUE_WORKER_CONCURRENCY=5
JOB_QUEUE_BATCH_SIZE=5
JOB_QUEUE_MAX_ATTEMPTS=5
JOB_QUEUE_BACKOFF_BASE_SECONDS=30
JOB_QUEUE_BACKOFF_CAP_SECONDS=1800
JOB_QUEUE_BACKOFF_JITTER_SECONDS=30
JOB_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
JOB_QUEUE_ITEM_DEADLINE_SECONDS=600
JOB_QUEUE_POLL_INTERVAL_SECONDS=5
JOB_QUEUE_IDLE_POLL_MAX_SECONDS=30

# Shared backoff applied to every worker thread on Azure OpenAI 429s.
LLM_RATE_LIMIT_BACKOFF_SECONDS=60

# On-demand summaries run in the API process via BackgroundTasks, which has
# no worker pool to bound it -- this is the only governor.
ON_DEMAND_MAX_CONCURRENT_SUMMARIES=3
ON_DEMAND_SUMMARY_ACQUIRE_TIMEOUT_SECONDS=30

# Reuse a stored summary when projection outputs are unchanged.
SUMMARY_MAX_REUSE_DAYS=7
SUMMARY_REUSE_ENABLED=false

# Lookback for PENDING summary rows stranded by a crash.
SUMMARY_PENDING_SWEEP_DAYS=3

# Informational only; the Container Apps Job cron defines the schedule.
PENALTY_BUSINESS_TIMEZONE=America/Chicago
PENALTY_DAILY_RUN_TIME=01:00
